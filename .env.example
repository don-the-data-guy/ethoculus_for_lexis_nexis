# =========================================================
# LexisNexis API configuration
#
# Fill these values using YOUR LexisNexis Developer Portal
# documentation. Do not commit the real .env file.
# =========================================================

LEXIS_API_BASE_URL=

# Protégé Ask endpoint path from Lexis documentation
LEXIS_PROTEGE_ASK_PATH=

# OAuth
#
# You may initially supply a valid OAuth access token.
# We will add automatic token acquisition once the exact
# Lexis OAuth grant flow for your account is confirmed.
LEXIS_ACCESS_TOKEN=

# These are reserved for automatic OAuth implementation.
LEXIS_OAUTH_TOKEN_URL=
LEXIS_CLIENT_ID=
LEXIS_CLIENT_SECRET=
LEXIS_OAUTH_SCOPE=
LEXIS_OAUTH_GRANT_TYPE=

# =========================================================
# API CONTRACT
#
# Set these from the exact Protégé API documentation.
# =========================================================

# JSON field containing the prompt/question.
LEXIS_PROMPT_FIELD=

# Dot-separated location of answer text in response.
# Example only: result.answer
#
# DO NOT use the example until confirmed by Lexis docs.
LEXIS_RESPONSE_TEXT_PATH=

LEXIS_TIMEOUT_SECONDS=90
